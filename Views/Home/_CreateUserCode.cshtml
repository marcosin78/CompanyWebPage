<!-- Emergent modal for CreateUser -->
<div id="create-user-modal" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.4);z-index:1000;">
    <div style="background:#fff;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);padding:32px 24px;border-radius:16px;min-width:350px;">
        <h2>Nuevo Usuario</h2>
        <form id="create-user-form" method="post" asp-action="GenerateUserCode">
            <div style="margin-bottom:16px;">
                <label for="department-select">Departamento:</label>
                <select id="department-select" name="DepartmentId" required>
                    @foreach (var dept in ViewBag.Departments)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
            </div>
            <div style="margin-bottom:16px;">
                <label for="code-input">Código:</label>
                <input type="text" id="code-input" name="Code" readonly required />
                <button type="button" id="generate-code-btn" style="margin-top:8px;">GENERAR</button>
            </div>
            <button type="submit" style="margin-top:16px;">Guardar</button>
        </form>
        <button type="button" id="close-create-user-modal" style="position:absolute;top:8px;right:8px;">✖</button>
    </div>
</div>