@{
    ViewData["Title"] = "Dashboard";
    var selectedDept = ViewBag.SelectedDepartment as string ?? "general";
    var userDeptId = ViewBag.UserDepartmentId?.ToString();
}
@model List<CompanyWebMarcBravo.Models.Post>
<div class="dashboard-container">
    <header class="dashboard-header">
        <h1>BRAVO COMPANY</h1>
        <div class="dashboard-department">
            <form method="get" asp-action="Dashboard" style="display:inline;">
                <input type="hidden" name="filter" value="general" />
                <button type="submit" class="dept-btn" style="@(selectedDept == "general" ? "font-weight:bold;" : "")">GENERAL</button>
            </form>
            <form method="get" asp-action="Dashboard" style="display:inline;">
                <input type="hidden" name="filter" value="department" />
                <button type="submit" class="dept-btn" style="@(selectedDept == "department" ? "font-weight:bold;" : "")">MI DEPARTAMENTO</button>
            </form>
        </div>
    </header>
    <form asp-action="Logout" method="post" style="position: absolute; top: 10px; right: 20px;">
    <button type="submit" id="logout-btn" style="padding: 8px 16px; border-radius: 20px; border: 1px solid #333; background: #fff; cursor: pointer;">
        Logout
    </button>
    </form>
    <div class="dashboard-body">
        <nav class="dashboard-sidebar">
            <form method="post" asp-action="Perfil">
                <button type="submit" class="sidebar-btn">PERFIL</button>
            </form>
            <form method="post" asp-action="Mensajes">
                <button type="submit" class="sidebar-btn">MENSAJES</button>
            </form>
            <button type="button" id="open-post-canvas-btn" class="sidebar-btn">POST</button>
            <form method="post" asp-action="Config">
                <button type="submit" class="sidebar-btn">CONFIG</button>
            </form>
        </nav>
        <main class="dashboard-main">
                <!-- Sección vacía para los posts de los trabajadores -->
                <section id="worker-posts">
                    <!-- Aquí se añadirán dinámicamente los posts de los trabajadores -->

                     @if (Model != null && Model.Count > 0)
    {
        foreach (var post in Model)
        {
            <div class="post-card" style="border:1px solid #ddd;border-radius:12px;padding:16px;margin-bottom:16px;background:#fff;box-shadow:0 2px 8px #0001;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                    <div>
                        <span style="font-weight:bold;">@post.Username</span>
                        <span style="color:#888;font-size:12px;margin-left:8px;">@post.CreatedAt.ToString("g")</span>
                    </div>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.Identity.Name == post.Username)
                    {
                        <form asp-action="DeletePost" asp-route-id="@post.Id" method="post" style="display:inline;">
                            <button type="submit" style="background:none;border:none;color:#c00;cursor:pointer;" title="Eliminar">🗑️</button>
                        </form>
                    }
                </div>
                <div style="margin:12px 0;">@post.Text</div>
                @if (!string.IsNullOrEmpty(post.ImagePath))
                {
                    <img src="@post.ImagePath" alt="Post image" style="max-width:100%;border-radius:8px;margin-top:8px;" />
                }
            </div>
        }
    }
    else
    {
        <div>No hay posts todavía.</div>
    }
                </section>
        </main>
        <aside class="dashboard-widgets">
            <div class="dashboard-widget">
                <!-- Aquí va el check o icono -->
                <input type="checkbox" />
            </div>
            <div class="dashboard-widget">
                <!-- Aquí va el calendario o widget -->
                <table>
                    <tr><td>L</td><td>M</td><td>X</td><td>J</td><td>V</td></tr>
                    <tr><td>1</td><td>2</td><td>3</td><td>4</td><td>5</td></tr>
                </table>
            </div>
        </aside>
    </div>
</div>

@await Html.PartialAsync("_PostCanvas")

<script src="~/js/dashboard.js"></script>